@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <FluentLayout>
            <FluentLayoutItem Area="LayoutArea.Header">
                <FluentLayoutHamburger />
                aspire-starter
                <FluentSpacer />
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Subtle">
                        <FluentIcon Value="@(new Icons.Filled.Size20.SignOut())" />
                        <FluentSpacer Width="50" />
                        Sign out
                    </FluentButton>
                </form>
            </FluentLayoutItem>
            <FluentLayoutItem Area="LayoutArea.Navigation">
                <NavMenu />
            </FluentLayoutItem>
            <FluentLayoutItem Area="LayoutArea.Content" Class="main">
                <div class="content">
                    @Body
                </div>
            </FluentLayoutItem>
        </FluentLayout>
    </Authorized>
    <NotAuthorized>
        <main>
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
